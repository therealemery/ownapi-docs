{
  "openapi": "3.1.0",
  "info": {
    "title": "Generate image",
    "version": "1.0.0",
    "description": "Create an image from a prompt. [Learn more](https://platform.openai.com/docs/guides/images)."
  },
  "tags": [
    {
      "name": "Images/Native OpenAI format"
    }
  ],
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/images/generations/": {
      "post": {
        "tags": [
          "Images/Native OpenAI format"
        ],
        "summary": "Generate image",
        "description": "Create an image from a prompt. [Learn more](https://platform.openai.com/docs/guides/images).",
        "operationId": "post-v1-images-generations",
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Image generation model: `dall-e-2`, `dall-e-3`, or `gpt-image-1`. Defaults to `dall-e-2` unless `gpt-image-1`-specific params are used."
                  },
                  "prompt": {
                    "type": "string",
                    "description": "Text prompt for the image. Max length: 32000 (`gpt-image-1`), 1000 (`dall-e-2`), 4000 (`dall-e-3`)."
                  },
                  "n": {
                    "type": "integer",
                    "description": "Number of images (1–10). For `dall-e-3`, only `n=1` is supported."
                  },
                  "size": {
                    "type": "string",
                    "description": "Size of the generated image. For `gpt-image-1`, must be one of `1024x1024`, `1536x1024` (landscape), `1024x1536` (portrait), or `auto` (default). For `dall-e-2`, must be one of `256x256`, `512x512`, or `1024x1024`. For `dall-e-3`, must be one of `1024x1024`, `1792x1024`, or `1024x1792`."
                  },
                  "background": {
                    "type": "string",
                    "description": "Background transparency for generated images. Supported only for `gpt-image-1`. Must be `transparent`, `opaque`, or `auto` (default). With `auto`, the model picks the best background.\n\nIf transparent, use an output format that supports alpha—`png` (default) or `webp`."
                  },
                  "moderation": {
                    "type": "string",
                    "description": "Moderation level for `gpt-image-1` images. Use `low` for less filtering or `auto` (default)."
                  },
                  "quality": {
                    "type": "string",
                    "description": "Quality of generated images."
                  },
                  "stream": {
                    "type": "string"
                  },
                  "style": {
                    "type": "string"
                  },
                  "user": {
                    "type": "string"
                  }
                },
                "required": [
                  "prompt"
                ],
                "x-apifox-orders": [
                  "model",
                  "prompt",
                  "n",
                  "size",
                  "background",
                  "moderation",
                  "quality",
                  "stream",
                  "style",
                  "user"
                ]
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "created": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "b64_json": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "url"
                        ],
                        "x-apifox-orders": [
                          "b64_json",
                          "url"
                        ]
                      }
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "total_tokens": {
                          "type": "integer"
                        },
                        "input_tokens": {
                          "type": "integer"
                        },
                        "output_tokens": {
                          "type": "integer"
                        },
                        "input_tokens_details": {
                          "type": "object",
                          "properties": {
                            "text_tokens": {
                              "type": "integer"
                            },
                            "image_tokens": {
                              "type": "integer"
                            }
                          },
                          "required": [
                            "text_tokens",
                            "image_tokens"
                          ],
                          "x-apifox-orders": [
                            "text_tokens",
                            "image_tokens"
                          ]
                        }
                      },
                      "required": [
                        "total_tokens",
                        "input_tokens",
                        "output_tokens",
                        "input_tokens_details"
                      ],
                      "x-apifox-orders": [
                        "total_tokens",
                        "input_tokens",
                        "output_tokens",
                        "input_tokens_details"
                      ]
                    }
                  },
                  "required": [
                    "created",
                    "data",
                    "usage"
                  ],
                  "x-apifox-orders": [
                    "created",
                    "data",
                    "usage"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
